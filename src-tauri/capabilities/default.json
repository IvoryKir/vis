{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Vis desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "opencode",
          "cmd": "opencode",
          "args": true,
          "sidecar": false
        },
        {
          "name": "setsid",
          "cmd": "setsid",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "opencode",
          "cmd": "opencode",
          "args": true,
          "sidecar": false
        },
        {
          "name": "setsid",
          "cmd": "setsid",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "shell:allow-kill",
    "clipboard-manager:allow-read-image"
  ]
}
